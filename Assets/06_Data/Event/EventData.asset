    resultScript: "\uADF8\uB294 \uB354 \uC774\uC0C1 \uC228\uC744 \uB0B4\uBC49\uAE30\uC870\uCC28
      \uD798\uB4E0\uC9C0, \n\uB0B4\uAC8C \uD68C\uBCF5 \uBB3C\uC57D\uC744 \uAC74\uB124\uACE0\uC11C
      \uC601\uC6D0\uD55C \uC7A0\uC5D0 \uB4E4\uC5C8\uB2E4."
    dialogue: "\uB4E4\uC5B4\uC8FC\uC5B4\uC11C \uACE0\uB9D9\uB2E4\u2026 \uC774\uAC83\uC744
      \uAC00\uC838\uAC00\uB77C...\n\uC138\uC0C1\uC774 \uAD76\uC8FC\uB824 \uAC00\uB294
      \uAC83, \uADF8\uAC83\uC744 \uB118\uC5B4 \uD3D0\uD5C8\uAC00 \uB418\uC5B4\uBC84\uB9B0
      \uAC74 \uC6B0\uC5F0\uC774 \uC544\uB2C8\uB2E4. \n\u2026\uBCF8\uAC70\uC9C0\uB97C
      \uCC3E\uC544\uAC00\uB77C. \uB2F9\uC2E0\uC774\uB77C\uBA74 \uD30C\uD5E4\uCE60
      \uC218 \uC788\uC744\uC9C0\uB3C4 \uBAA8\uB974\uC9C0."
    endScript: "\uCCB4\uB825 [h] \uD68C\uBCF5"
  - scriptCode: 11004
    resultScript: "\uC9C4\uC791 \uD798\uC774 \uB2E4\uD55C \uC2E0\uB3C4\uB294 \uBC18\uD56D
      \uD55C \uBC88 \uBABB \uD558\uACE0 \uC228\uC744 \uAC70\uB450\uC5C8\uB2E4. \n\uADF8\uAC00
      \uAC00\uC9C0\uACE0 \uC788\uB294 \uAC83\uC774\uB77C\uACE0\uB294 \uC57D\uAC04\uC758
      \uB3C8\uBFD0\uC774\uC5C8\uB2E4. \uCC59\uACA8\uB450\uB294 \uAC8C \uC88B\uACA0\uB2E4."
    dialogue: "\uC73D...... "
    endScript: "\uAE08\uC561 [c] \uD68D\uB4DD"
  - scriptCode: 11005
    resultScript: "\uAE08\uBC29 \uC8FD\uC744 \uD14C\uB2C8 \uBB34\uC2DC\uD558\uC790\uACE0
      \uC0DD\uAC01\uD588\uC73C\uB098, \uC704 \uB9D0\uACFC \uD568\uAED8 \uADF8\uAC00
      \uC2B5\uACA9\uD588\uB2E4. \n\uB4F1\uC744 \uAC00\uACA9\uD55C \uCC28\uAC11\uACE0
      \uC4F0\uB77C\uB9B0 \uAC10\uAC01\uC5D0 \uBC18\uACA9\uD558\uACE0\uC790 \uACE7\uBC14\uB85C
      \uB4A4\uB3CC\uC544\uBD24\uC744 \uB54C, \uD754\uC801\uC870\uCC28 \uBCF4\uC774\uC9C0
      \uC54A\uC558\uB2E4. \n\uADF8\uAC00 \uC788\uB358 \uC790\uB9AC\uC5D0\uB294 \uD574\uC9C4
      \uC778\uD615 \uD558\uB098\uAC00 \uB0A8\uC544\uC788\uC744 \uBFD0\uC774\uC5C8\uB2E4."
    dialogue: "\uB4E4\uC740 \uCCB4\uB3C4...\uC548\uD558\uB294 \uAD70... \uADF8\uB7FC...
      \uC2E4\uB840\uD558\uACA0\uB124..."
    endScript: "\uCCB4\uB825 [h] \uC18C\uC2E4,\n[\uB354\uBBF8] \uD68D\uB4DD"
  - scriptCode: 11006
    resultScript: "\uB9C8\uCE68 \uAE30\uACC4 \uD314\uC774 \uC5B4\uB5BB\uAC8C \uAC15\uB825\uD55C
      \uD798\uC744 \uAC00\uC9C0\uB294\uC9C0 \uC758\uC544\uD588\uB358 \uCC38\uC774\uC5C8\uB2E4.
      \n\uBD84\uD574\uD560 \uB3C4\uAD6C\uAC00 \uC5C6\uAE30\uC5D0 \uD558\uB294 \uC218
      \uC5C6\uC774 \uAE30\uACC4 \uD314\uC744 \uD798\uAECF \uB0B4\uB9AC\uCCE4\uB2E4.
      \n\uCF85!!\n\uAD49\uC74C\uACFC \uD568\uAED8 \uBD80\uC11C\uC9C4 \uAE30\uACC4
      \uD314 \uB0B4\uBD80\uC5D0\uC11C \uC4F8 \uB9CC\uD55C \uBD80\uD488 \uD558\uB098\uAC00
      \uB208\uC5D0 \uB748\uB2E4."
    dialogue: 
    endScript: "[\uC120\uD0DD\uD55C \uCE74\uB4DC] \uD68D\uB4DD"
  - scriptCode: 11007
    resultScript: "\uC9C0\uAE08\uC758 \uAE30\uACC4 \uD314\uC744 \uCC29\uC6A9\uD558\uACE0\uC11C
      \uCC98\uC74C \uB290\uAF08\uB358 \uAC10\uC815\uC774 \uB5A0\uC624\uB978\uB2E4.
      \n\uAC10\uC5FC\uC790\uC5D0\uAC8C\uC11C \uAE30\uACC4 \uD314\uC744 \uB5BC\uC5B4\uB0B4
      \uCC29\uC6A9\uD588\uB2E4\uB294 \uC0AC\uC2E4\uC744 \uC778\uC9C0\uD588\uC744
      \uB54C\uC758\u2026 \uB450\uB824\uC6C0. \n\uAC74\uB4DC\uB9AC\uACE0 \uC2F6\uC9C0\uB3C4
      \uC54A\uB2E4\uB294 \uC0DD\uAC01\uC5D0 \uC560\uC368 \uBB34\uC2DC\uD558\uACE0
      \uB9C8\uC800 \uB098\uC544\uAC00\uAE30\uB85C \uD588\uB2E4."
    dialogue: 
    endScript: "\uC544\uBB34 \uC77C\uB3C4 \uC77C\uC5B4\uB098\uC9C0 \uC54A\uC558\uB2E4"
  - scriptCode: 11008
    resultScript: "\uAE30\uACC4 \uD314\uC744 \uBE44\uC2F8\uAC8C \uD314 \uC218 \uC788\uC9C0
      \uC54A\uC744\uAE4C \uC2F6\uC5B4, \uB4E4\uACE0 \uC554\uC2DC\uC7A5\uC73C\uB85C
      \uD5A5\uD588\uB2E4.\n\uC554\uC0C1\uC778\uC740 \uD130\uBB34\uB2C8\uC5C6\uC774
      \uC801\uC740 \uAE08\uC561\uC744 \uC81C\uC2DC\uD588\uACE0, \n\uB098\uB294 \uBC18\uBC1C\uD588\uC73C\uB098
      \uC989\uC2DC \uADF8\uAC00 \uACE0\uC6A9\uD55C \uC6A9\uBCD1\uC5D0\uAC8C \uC81C\uC555\uB2F9\uD588\uB2E4.\n\uC544\uBB34\uB798\uB3C4
      \uC774 \uC774\uC0C1 \uB3C8\uC744 \uBC1B\uB294 \uAC74 \uC5B4\uB835\uACA0\uC9C0...
      \uD558\uB294 \uC218 \uC5C6\uC774 \uAC70\uB798\uB97C \uBC1B\uC544\uB4E4\uC600\uB2E4."
    dialogue: "\uC5B4\uB514 \uAC00\uC11C \uC774 \uC774\uC0C1 \uBD80\uB974\uB294 \uC9D1\uC740
      \uC5C6\uC744 \uAC70\uC694. \n\uC2E0\uC6D0 \uBCF4\uC7A5\uB3C4 \uC548\uB418\uB294
      \uAC78 \uAC70\uB798\uD558\uB824 \uB4E0 \uAC74\uB370 \uADF8 \uC815\uB3C4\uB294
      \uAC10\uC218\uD574\uC57C\uC9C0...\n\uD074\uD074\uD074... \uC798 \uC0DD\uAC01\uD588\uC18C.
      \uC5EC\uAE30 \uBC1B\uC544\uAC00\uC2DC\uC624."
    endScript: "\uCCB4\uB825 [h] \uC18C\uC2E4,\n\uAE08\uC561 [c] \uD68D\uB4DD\n"
  - scriptCode: 11009
    resultScript: "\uBCF5\uC2A4 \uAC94\uB9AC\uB2E4\uC758 \uC2E0\uB3C4\uB294 \uD600\uB97C
      \uCC28\uACE0\uB294 \uBA3C\uC800 \uC0AC\uB77C\uC84C\uB2E4. \n\uAC15\uC2E0\uD68C\uC758
      \uC2E0\uB3C4\uB294 \uD638\uD0D5\uD558\uAC8C \uC6C3\uACE0\uB294 \uB098\uC5D0\uAC8C
      \uADF8\uB300\uB85C \uAE30\uB984\uC744 \uB4E4\uC774\uBD80\uC5C8\uB2E4.\n\uB728\uAC70\uC6C0\uB3C4
      \uC7A0\uC2DC \uB530\uB73B\uD574\uC9C0\uBA70 \uD798\uC774 \uC2A4\uBA70\uB4E6\uACFC
      \uB3D9\uC2DC\uC5D0 \uBB34\uC5B8\uAC00 \uC783\uC740 \uB4EF\uD55C \uB290\uB08C\uC774
      \uB4E4\uC5C8\uB2E4."
    dialogue: "A \" \uD6C4\uD558\uD558\uD558! \uB204\uAD70\uC9C0\uB294 \uBAA8\uB974\uACA0\uC9C0\uB9CC
      \uBCF4\uB294 \uB208\uC774 \uC788\uAD6C\uB9CC! \"\nB \" \uC6B0\uC790\uC758 \uC2DD\uACAC\uC774\uB85C\uAD70\uC694.
      \uC548\uD0C0\uAE4C\uC6B8 \uB530\uB984\uC785\uB2C8\uB2E4. \" "
    endScript: "[\uC120\uD0DD\uD55C \uCE74\uB4DC] \uD68D\uB4DD\n[\uC0AC\uC774\uD0A5
      \uC18D\uC131 \uCE74\uB4DC \uC911 1\uAC1C] \uC783\uC74C"
  - scriptCode: 11010
    resultScript: "\uAC15\uC2E0\uD68C\uC758 \uC2E0\uB3C4\uB294 \uD558\uCC2E\uB2E4\uB294
      \uB4EF \uC5B4\uAE68\uB97C \uC73C\uC4F1\uC774\uBA70 \uBC18\uB300 \uBC29\uD5A5\uC73C\uB85C
      \uAC78\uC5B4\uB098\uAC14\uB2E4.\n\uBCF5\uC2A4 \uAC94\uB9AC\uB2E4 \uC2E0\uB3C4\uB294
      \uBBF8\uC18C\uC9C0\uC73C\uBA70 \uB0B4\uAC8C \uC57D\uD488\uC744 \uD558\uB098
      \uAC74\uB124\uC8FC\uC5C8\uB2E4.\n\uC57D\uD488\uC744 \uB9C8\uC2DC\uC790 \uBAB8\uC5D0
      \uB0C9\uAE30\uAC00 \uAC10\uB3CC\uBA70 \uC0C8\uB85C\uC6B4 \uD798\uC774 \uD53C\uC5B4\uB0AC\uB2E4.
      \uBB34\uC5B8\uAC00 \uC783\uC740 \uB4EF\uD55C \uB290\uB08C\uACFC \uD568\uAED8."
    dialogue: "B  \" \uC798 \uC544\uC2DC\uB294\uAD70\uC694. \uC774\uB984 \uBAA8\uB97C
      \uB098\uADF8\uB124\uC5EC. \" \nA  \" \uD798\uC774\uC57C\uB9D0\uB85C \uBAA8\uB4E0
      \uAC83\uC784\uC744 \uBAA8\uB974\uB294\uAD70. \uB098\uC57D\uD55C \uAC83\uB4E4...
      \""
    endScript: "[\uC120\uD0DD\uD55C \uCE74\uB4DC] \uD68D\uB4DD\n[\uD30C\uAD34 \uC18D\uC131
      \uCE74\uB4DC \uC911 1\uAC1C] \uC783\uC74C"
  - scriptCode: 11011
    resultScript: "\u2015\uD37D. \n\uC880 \uB354 \uC790\uC138\uD788 \uB4E3\uAE30
      \uC704\uD574 \uBAB8\uC744 \uC6C0\uC9C1\uC774\uB824\uB358 \uCC30\uB098 \n\uB4A4\uD1B5\uC218\uC5D0
      \uBB35\uC9C1\uD55C \uCDA9\uACA9\uC774 \uB290\uAEF4\uC9D0\uACFC \uB3D9\uC2DC\uC5D0
      \uC2DC\uC57C\uAC00 \uAEBC\uC84C\uB2E4. \n\uC815\uC2E0\uC744 \uCC28\uB838\uC744
      \uB54C \uB450 \uC0AC\uB78C\uC740 \uC774\uBBF8 \uC0AC\uB77C\uC9C0\uACE0 \uC5C6\uC5C8\uB2E4.\n\uC5EC\uAE30\uC11C
      \uB354 \uC5BB\uC744 \uC815\uBCF4\uB294 \uC5C6\uB2E4. \uC660\uC9C0 \uBAA8\uB97C
      \uBD88\uCF8C\uAC10\uC744 \uB4A4\uB85C \uD55C \uCC44 \uC77C\uB2E8 \uC790\uB9AC\uB97C
      \uB5B4\uB2E4."
    dialogue: "A \" \uC785\uB9CC \uC0B4\uC558\uAD70. \uC57D\uD574\uBE60\uC9C4 \uAC83\uB4E4\uC774\uB780...
      \" \nB \" \uC6B0\uB9AC \uBCF5\uC2A4 \uAC94\uB9AC\uB2E4\uB294 \uB2F9\uC2E0\uB124\uB4E4\uACFC\uB294
      \uB2E4\uB985\uB2C8\uB2E4. \n\uC9C0\uAE08\uB3C4 \uC704\uB300\uD55C \uBAA9\uC801\uC744
      \uD5A5\uD574 \uAC00\uACE0 \uC788\uC9C0\uC694.\" \nA \" \uC704\uB300\uD55C \uBAA9\uC801?
      \uD558! \uADF8\uB798\uC11C \uC9C0\uAE08 \uB124 \uB188\uC774 \uAE38\uC744 \uAC00\uB85C\uB9C9\uACE0
      \n      \uC774\uB807\uAC8C \uC9C0\uAEC4\uC774\uB294 \uAC83\uB3C4 \uC704\uB300\uD55C
      \uBAA9\uC801\uC744 \uC704\uD574\uC11C\uC778\uAC00? \" \nB \"\uC77C\uAC1C \uD558\uAE09
      \uC2E0\uC790\uAC00 \uBB34\uC5C7\uC744 \uC54C\uACA0\uC2B5\uB2C8\uAE4C. \uB2E4\uB9CC,
      \n\uADF8\uCABD\uC774\uB098 \uC800\uB098 \uBCF8\uB2F9\uC73C\uB85C \uAC00\uB294
      \uAE38\uC740 \uD5C8\uB77D\uB418\uC9C0 \uC54A\uC558\uC9C0\uC694. \uADF8 \uC774\uC720\uB294
      \uC54C\uACE0 \uACC4\uC2ED\uB2C8\uAE4C? \""
    endScript: "\uCCB4\uB825 [h] \uC18C\uC2E4\n[\uC120\uD0DD\uD55C \uCE74\uB4DC]
      \uD68D\uB4DD"
  - scriptCode: 11012
    resultScript: "\uADF8\uB294 \uC774\uBBF8 \uAC10\uC5FC\uB418\uC5B4 \uC788\uC5C8\uB2E4.
      \n\uB2E4\uAC00\uC624\uC9C0 \uB9D0\uB77C\uB294 \uB9D0\uC744 \uB4E3\uACE0\uC11C
      \uAE09\uD558\uAC8C \uBC29\uC5B4 \uD0DC\uC138\uB97C \uAC16\uCD94\uC5C8\uC73C\uB098
      \uB54C\uB294 \uB2A6\uC5C8\uB2E4. \n\uAC11\uC791\uC2A4\uB7FD\uAC8C \uB2EC\uB824\uB4E0
      \uADF8\uAC00 \uB0B4 \uC5B4\uAE68\uB97C \uBB3C\uC5B4 \uB72F\uC5C8\uB2E4. \n\uC4F0\uB77C\uB9B0
      \uACE0\uD1B5\uACFC \uD568\uAED8 \uBB34\uC5B8\uAC00\uAC00 \uC790\uB77C\uB098\uB294
      \uB290\uB08C\uC774 \uB4E0\uB2E4."
    dialogue: "\uADF8\uC73C\uC73D, \uC73D, \uC624...\uC624\uC9C0\u2026 \uB9C8\u2026\u2026! "
    endScript: "\uCCB4\uB825 [h] \uC18C\uC2E4\n[\uC120\uD0DD\uD55C \uCE74\uB4DC]
      \uD68D\uB4DD"
  - scriptCode: 11013
    resultScript: "\uADF8\uB294 \uC774\uBBF8 \uAC10\uC5FC\uB418\uC5B4 \uC788\uC5C8\uB2E4.
      \n\uC77C\uCC0D\uC774 \uACF5\uACA9 \uD0DC\uC138\uB97C \uAC16\uCD98 \uB355\uBD84\uC5D0
      \uACF5\uACA9\uD574\uC624\uB294 \uADF8\uB97C \uB9C9\uC744 \uC218 \uC788\uC5C8\uB2E4.
      \n\uB0B4\uAC00 \uD560 \uC218 \uC788\uB294\uAC74 \uADF8\uC800 \uBAA9\uC228\uC744
      \uB04A\uC5B4\uC8FC\uB294 \uAC83 \uBFD0... \uBD80\uB514 \uD3B8\uD788 \uC601\uBA74\uD558\uAE30\uB97C...\n\uADF8
      \uC790\uAC00 \uC788\uB358 \uACF3\uC5D0\uC11C \uC8FC\uC778 \uC783\uC740 \uB3C8\uC744
      \uBC1C\uACAC\uD588\uB2E4. \uCC59\uACA8\uB450\uB294 \uD3B8\uC774 \uC88B\uACA0\uB2E4."
    dialogue: "\uADF8\uC5B4\uC5B4\uC5B4... "
    endScript: "\uCCB4\uB825 [h] \uC18C\uC2E4\n\uAE08\uC561 [c] \uD68D\uB4DD"
  - scriptCode: 11014
    resultScript: "\uB4F1 \uB4A4\uC5D0\uC11C \uC778\uAC04\uC758 \uBAA9\uC18C\uB9AC\uC640
      \uC778\uAC04\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uC544\uB2CC \uAC83\uC774 \uC11E\uC5EC
      \uB4E4\uB824\uC628\uB2E4. \n\uB2E4\uAC00\uAC00\uC9C0 \uC54A\uAE30\uB97C \uC798\uD588\uB2E4\uB294
      \uC0DD\uAC01\uC774 \uB4E4\uC5C8\uB2E4.\n\uADF8\uC758 \uB9C8\uC9C0\uB9C9 \uB9D0\uC774
      \uB1CC\uB9AC\uC5D0 \uC0C8\uACA8\uC9C8 \uAC83\uB9CC \uAC19\uC9C0\uB9CC, \uAC78\uC74C\uC744
      \uBA48\uCD94\uC9C0\uB294 \uC54A\uAE30\uB85C \uD588\uB2E4."
    dialogue: "\uADF8\uC5B4... \uC544\uD30C... \uC0B4\uACE0... \uC2F6... \n"
    endScript: "\uC544\uBB34 \uC77C\uB3C4 \uC77C\uC5B4\uB098\uC9C0 \uC54A\uC558\uB2E4"
  - scriptCode: 11015
    resultScript: "\uBB3C\uC57D\uC744 \uB4E4\uC774\uD0A4\uC790\uB9C8\uC790 \uC77C\uC21C\uAC04
      \uC138\uC0C1\uC774 \uBD80\uC11C\uC9C0\uB4EF \uC2DC\uC57C\uAC00 \uB4A4\uD2C0\uB838\uB2E4.
      \n\uC5B4\uC9C0\uB7EC\uC6C0\uACFC \uB3D9\uC2DC\uC5D0 \uB290\uAEF4\uC9C0\uB294
      \uAC74 \uD669\uD640\uD55C \uCF8C\uB77D\u2026 \uC5B4\uCA50\uC9C0 \uAE30\uC6B4\uC774
      \uB09C\uB2E4. \n\uBC29\uAE08 \uBB34\uC5B8\uAC00\uB97C \uC783\uC5B4\uBC84\uB9B0
      \uAC83 \uAC19\uC9C0\uB9CC, \uB2F9\uC7A5\uC740 \uC2E0\uACBD \uC4F0\uC774\uC9C0
      \uC54A\uB294\uB2E4."
    dialogue: 
    endScript: "[\uB79C\uB364\uD55C \uCE74\uB4DC] \uC18C\uC2E4\n\uCCB4\uB825 [h]
      \uD68C\uBCF5"
  - scriptCode: 11016
    resultScript: "\uC5BC\uB9C8\uB098 \uB354 \uAC78\uC5C8\uC744\uAE4C. \uAC11\uC791\uC2A4\uB7EC\uC6B4
      \uAC08\uC99D\uC5D0 \uC870\uAE08 \uC804\uC5D0 \uCC59\uAE34 \uADF8 \uD478\uB978
      \uBB3C\uC57D\uC774\uB77C\uB3C4 \uB9C8\uC2E4\uAE4C \uC2F6\uC5C8\uC73C\uB098\u2026
      \n\uC544\uBB34\uB9AC \uC8FC\uBA38\uB2C8\uB97C \uB4A4\uC838\uB3C4 \uC628\uB370\uAC04\uB370\uC5C6\uB2E4.
      \uB5A8\uC5B4\uB728\uB838\uB2E4\uBA74 \uBD84\uBA85 \uC18C\uB9AC\uAC00 \uB4E4\uB838\uC744
      \uD150\uB370. \n\uB9C8\uCE58 \uBB34\uC5B8\uAC00\uC5D0 \uD640\uB9B0 \uAE30\uBD84\uC774\uC9C0\uB9CC,
      \uB531 \uADF8\uBFD0\uC774\uB2E4. \uAC08\uC99D\uC744 \uC548\uC740 \uCC44\uB85C,
      \uB9C8\uC800 \uB098\uC544\uAC00\uB294 \uC218\uBC16\uC5D0."
    dialogue: 
    endScript: "\uC544\uBB34 \uC77C\uB3C4 \uC77C\uC5B4\uB098\uC9C0 \uC54A\uC558\uB2E4"
  - scriptCode: 11017
