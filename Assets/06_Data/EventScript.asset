    EventChoice2: 1016
    EventChoice3: 1017
  scriptList:
  - ScriptCode: 100
    EventScript: "\uB85C\uBE0C\uB97C \uAC78\uCE5C \uC0AC\uB78C\uC774 \uC808\uB69D\uAC70\uB9AC\uBA70
      \uB2E4\uAC00\uC640 \uB9D0\uC744 \uAC78\uC5B4\uC628\uB2E4. \n\uD55C\uBC88\uB3C4
      \uBCF8 \uC801 \uC5C6\uB294 \uC778\uC0C1\uC778\uB370\u2026 \n\uBBF8\uC2EC\uCA4D\uC9C0\uB9CC
      \uAC70\uB798\uC5D0 \uC751\uD558\uB294 \uAC83\uB3C4 \uB098\uC058\uC9C0 \uC54A\uC744
      \uAC83 \uAC19\uB2E4\uB294 \uC0DD\uAC01\uC774 \uB4E4\uC5C8\uB2E4."
    Dialogue: "\"\" \uC7A0\uAE50, \uC790\uB124\u2026\u2026 \n\uB098\uC640 \uAC70\uB798
      \uD558\uB098 \uD558\uC9C0 \uC54A\uACA0\uB294\uAC00... \"\""
    Illustration: Npc
  - ScriptCode: 101
    EventScript: "\uC8FD\uC74C\uC758 \uB0C4\uC0C8\uAC00 \uB4DC\uB9AC\uC6B4 \uC778\uAC04\u2026
      \uC804\uC7C1\uC744 \uC624\uB798 \uACAA\uC5C8\uB2E4 \uBCF4\uB2C8 \uBC14\uB85C
      \uC54C \uC218 \uC788\uB2E4. \n\uADF8\uB7F0 \uADF8\uAC00 \uBC14\uB2E5\uC5D0
      \uC8FC\uC800\uC549\uC544 \uB9D0\uC744 \uAC78\uC5B4\uC628\uB2E4. \n\uAC78\uCE5C
      \uC637\uC758 \uD615\uD0DC\uB85C \uBCF4\uC544 \uBCF5\uC2A4 \uAC94\uB9AC\uB2E4\uC758
      \uC2E0\uB3C4\uC778 \uB4EF\uD55C\uB370, \n\uC123\uBD88\uB9AC \uB2E4\uAC00\uAC14\uB2E4\uAC00
      \uD654\uB97C \uB2F9\uD560\uC9C0\uB3C4 \uBAA8\uB978\uB2E4\uB294 \uC0DD\uAC01\uC774
      \uB4E0\uB2E4. \n\uADF8\uB798\uB3C4 \uC774\uC57C\uAE30\uB97C \uB4E4\uC5B4\uBCF4\uB294
      \uAC8C \uC88B\uC744\uAE4C?"
    Dialogue: "\"\" \uADF8\uB300, \uC2DC\uAC04\uC774 \uC788\uB2E4\uBA74\u2026 \uB0B4\uAC00
      \uD558\uB294 \uB9D0\uC744\u2026 \uB4E3\uACE0 \uAC00\uB77C\u2026\"\""
    Illustration: Npc
  - ScriptCode: 102
    EventScript: "\uBC14\uB2E5\uC5D0 \uAE30\uACC4 \uD314\uC774 \uB369\uADF8\uB7EC\uB2C8
      \uBC84\uB824\uC838 \uC788\uB2E4. \n\uB0B4\uAC00 \uAE30\uACC4 \uD314\uC744 \uC5BB\uAE30
      \uC804\uC774\uB77C\uBA74 \uBC14\uB85C \uCC29\uC6A9\uD588\uACA0\uC9C0\uB9CC
      \uC9C0\uAE08\uC758 \uB0B4\uAC8C\uB294 \uD544\uC694\uD558\uC9C0 \uC54A\uB2E4.
      \n\uB2E4\uB978 \uC0AC\uB78C\uC774 \uC774 \uBAA8\uC2B5\uC744 \uBD24\uB2E4\uBA74
      \uC8FC\uC800\uC5C6\uC774 \uB0B4 \uBEA8\uC744 \uD6C4\uB824\uAC08\uAE30\uACE0
      \uAE30\uACC4 \uD314\uC744 \uCC28\uC9C0\uD558\uB824 \uB4E4\uACA0\uC9C0. \n\uB2E4\uD589\uD788
      \uC8FC\uBCC0\uC5D0\uB294 \uC544\uBB34\uB3C4 \uC5C6\uB2E4."
    Dialogue: 
    Illustration: "MechanicArm\n(\uD30C\uC77C\uBA85: Machine)"
  - ScriptCode: 103
    EventScript: "\uBA40\uB9AC\uC11C \uB450 \uC0AC\uB78C\uC774 \uC2F8\uC6B0\uACE0
      \uC788\uB2E4. \n\uBAA9\uC801\uC9C0\uB85C \uAC00\uAE30 \uC704\uD574\uC11C\uB294
      \uC774 \uAE38\uC744 \uC9C0\uB098\uAC00\uC57C \uD558\uB294\uB370, \uB9D0\uC744
      \uAC78\uC9C0 \uC54A\uACE0\uC11C\uC57C \uBB34\uB9AC\uC77C \uAC83 \uAC19\uB2E4.
      \n\uC5B4\uCA50\uC9C0 \uB9D0\uB2E4\uD23C\uC774 \uC2EC\uD574\uC9C0\uB294 \uAC83
      \uAC19\uAE30\uB3C4 \uD55C\uB370."
    Dialogue: "A \u201C \uAC81\uC7C1\uC774\uB9C8\uB0E5 \uB4A4\uC5D0 \uC228\uC5B4
      \uBA38\uB9AC\uB098 \uAD74\uB9AC\uB294 \uC8FC\uC81C\uC5D0 \uC73C\uC2A4\uB300\uC9C0\uB9C8\uB77C!
      \n\uB124\uB188\uB4E4 \uBCF5\uC2A4 \uAC94\uB9AC\uB2E4 \uD328\uAC70\uB9AC\uB294
      \uD55C \uC8FC\uBA39\uB3C4 \uC548 \uB418\uB2C8!\u201D \nB \u201C \uC6B0\uC2B5\uAD70\uC694.
      \n\uC6B0\uB9AC\uC758 \uC704\uB300\uD55C \uC9C0\uC2DD \uC5C6\uC774\uB294 \uB208\uBA3C
      \uBA67\uB3FC\uC9C0\uB9C8\uB0E5 \uB0A0\uB6F0\uB294\uAC8C \uC804\uBD80\uC778
      \uBA4D\uCCAD\uC774 \uC9D1\uB2E8\uC774. \u201D "
    Illustration: Npc
  - ScriptCode: 104
    EventScript: "\uC804\uC7C1 \uC911 \uAC19\uC740 \uBD80\uB300\uC5D0\uC11C \uC9C0\uB0C8\uB358
      \uC790\uB97C \uC6B0\uC5F0\uD788 \uC870\uC6B0\uD588\uB2E4. \n\uC57D 6\uB144
      \uC804\uC758 \uC77C, \uADF8\uB807\uAC8C \uC624\uB798\uB418\uC5C8\uC74C\uC5D0\uB3C4
      \uC11C\uB85C\uB97C \uB2E8\uBC88\uC5D0 \uC54C\uC544\uBCF8 \uB4EF \uC2DC\uC120\uC744
      \uD53C\uD558\uC9C0 \uC54A\uC558\uB2E4. \n\uB2E4\uB9CC \uC5BC\uD54F \uBCF8 \uADF8\uC758
      \uC0C1\uD0DC\uAC00 \uC2EC\uC0C1\uCE58 \uC54A\uC558\uB2E4. \n\uB9C8\uCE58, \uB354
      \uC774\uC0C1 \uC778\uAC04\uC774 \uC544\uB2CC \uB4EF\uD55C \uB0AF\uBE5B. \uC815\uB9D0
      \uB098\uB97C \uC54C\uC544\uBCF8 \uAC8C \uB9DE\uB098?"
    Dialogue: '"" ....... ""'
    Illustration: Npc
  - ScriptCode: 105
    EventScript: "\uD3D0\uD5C8\uAC00 \uB41C \uC138\uACC4\uC758 \uAE38\uBC14\uB2E5\uC5D0
      \uC804\uD600 \uC5B4\uC6B8\uB9AC\uC9C0 \uC54A\uB294 \uAE30\uBB18\uD558\uACE0
      \uC544\uB984\uB2E4\uC6B4 \uBB3C\uC57D\uC774 \uB5A8\uC5B4\uC838 \uC788\uB2E4.
      \n\uC720\uB9AC\uBCD1\uC784\uC5D0\uB3C4 \uAE68\uC9C0\uAE30\uB294\uCEE4\uB155
      \uC2E4\uAE08\uC870\uCC28 \uC5C6\uC774 \uAE68\uB057\uD558\uB2C8 \uC218\uC0C1\uD558\uAE30
      \uC9DD\uC774\uC5C6\uB2E4. \n\uD558\uC9C0\uB9CC \uC774\uB7F0 \uD5D8\uC9C0\uC5D0\uC11C
      \uBB3C\uC790\uB294 \uADC0\uD55C \uBC95, \n\uD65C\uC6A9\uD560 \uBC29\uBC95\uB9CC
      \uC548\uB2E4\uBA74 \uC720\uC6A9\uD558\uAC8C \uC4F8 \uC218 \uC788\uC9C0 \uC54A\uC744\uAE4C...
      \n\uBCD1\uC744 \uB4E4\uC5B4 \uC561\uCCB4\uB97C \uD754\uB4E4\uC5B4\uBCF4\uB2C8
      \uC740\uC740\uD55C \uD478\uB978 \uBE5B\uC744 \uB0B4\uACE0 \uC788\uC5C8\uB2E4."
    Dialogue: 
    Illustration: "Potion\n(\uD30C\uC77C\uBA85: Flask)"
