  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "- \uC810\uD654 + \uAE30\uB984 \uBFCC\uB9AC\uAE30\uB85C \uC801\uC5D0\uAC8C
    \uD654\uC0C1\uC744 \uB204\uC801\uC2DC\uD0A4\uACE0, \uBC31\uB4DC\uB798\uD504\uD2B8\uB85C
    \uD654\uC0C1 \uC801 \uC804\uCCB4\uC5D0 \uAD11\uC5ED \uB370\uBBF8\uC9C0 \uC5F0\uACC4\r\n-
    \uBD88\uC528\uB294 \uC0AC\uC6A9 \uC2DC \uC18C\uBA78\uD558\uBA74\uC11C \uC790\uAE30
    \uC790\uC2E0\uC744 \uB371\uC5D0 \uBCF5\uC0AC\uD558\uBBC0\uB85C, \uBC18\uBCF5
    \uC0AC\uC6A9\uC73C\uB85C \uC18C\uBA78 \uCE74\uB4DC \uB354\uBBF8\uB97C \uC313\uC740
    \uB4A4 \uBC31\uC5FC\uC73C\uB85C \uC18C\uBA78 \uB354\uBBF8 \uC218\uC5D0 \uBE44\uB840\uD55C
    \uAC15\uB825\uD55C \uB370\uBBF8\uC9C0\r\n- \uC77C\uBD80 \uCE74\uB4DC\uB294 \uC790\uC2E0\uC5D0\uAC8C\uB3C4
    \uD654\uC0C1\uC744 \uAC70\uBBC0\uB85C, \uB2E8\uB828\uC73C\uB85C \uB192\uC740
    \uBC29\uC5B4\uB3C4\uB97C \uC62C\uB824 \uC790\uD574 \uD53C\uD574\uB97C \uC0C1\uC1C4\uD558\uAC70\uB098,
    \uC794\uBD88\uB85C \uB300\uB7C9 \uB4DC\uB85C\uC6B0\uB97C \uB04C\uC5B4\uC640 \uD578\uB4DC
    \uD68C\uC804\uB825 \uD655\uBCF4"
